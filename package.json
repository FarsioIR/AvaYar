{
  "name": "avayar-farsio-runtime",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Executable foundation for AvaYar, a Farsio product.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "node --test",
    "build": "node scripts/build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run lint && npm test && npm run build && npm run smoke",
    "live:free-provider": "node scripts/live-free-provider-probe.mjs",
    "live:extract": "node scripts/live-extraction-probe.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@mozilla/readability": "0.6.0",
    "franc-min": "6.2.0",
    "jsdom": "30.0.1",
    "msedge-tts": "2.0.7"
  }
}
