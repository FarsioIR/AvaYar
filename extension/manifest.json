{
  "manifest_version": 3,
  "name": "AvaYar · آوایار",
  "version": "0.6.0",
  "description": "متن فارسی و انگلیسی صفحه را به فارسی بخوان و خلاصه کن.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://farsio.ir/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "بازکردن آوایار",
    "default_popup": "sidepanel.html",
    "default_icon": {
      "16": "assets/avayar-mark-16.png",
      "32": "assets/avayar-mark-32.png",
      "48": "assets/avayar-mark-48.png",
      "128": "assets/avayar-mark-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "assets/avayar-mark-16.png",
    "32": "assets/avayar-mark-32.png",
    "48": "assets/avayar-mark-48.png",
    "128": "assets/avayar-mark-128.png"
  }
}
