# AvaYar runtime configuration

AVAYAR_TRANSLATION_DEFAULT_SOURCE=en

# Optional local translation model cache
# AVAYAR_MODEL_CACHE=/var/cache/avayar/models

# Server-side only Gemini credential.
# Never embed this value inside the extension.
GEMINI_API_KEY=

# Production HTTP runtime
HOST=0.0.0.0
PORT=4173

AVAYAR_REQUEST_TIMEOUT_MS=120000

AVAYAR_RATE_LIMIT_WINDOW_MS=60000
AVAYAR_RATE_LIMIT_MAX=120

# Exact allowed browser/application origins.
AVAYAR_CORS_ORIGINS=https://farsio.ir

# Runtime translation provider.
# Production should use gemini.
# Development may use local-m2m100.
AVAYAR_TRANSLATION_PROVIDER=local-m2m100

AVAYAR_TRANSLATION_MODEL=gemini-flash-latest

# Extension build configuration:
#
# Development build:
# AVAYAR_EXTENSION_MODE=development
#
# Production build:
# AVAYAR_EXTENSION_MODE=production
# AVAYAR_PRODUCTION_API_BASE=https://api.example.com
#
# Production builds fail unless the API base is HTTPS.
