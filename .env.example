# Ava M3 Azure provider configuration.
# Copy to .env only for your own local workflow if you use a loader.
# The runtime itself reads process environment variables and never reads this
# file automatically.

AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
