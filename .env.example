# AvaYar runtime configuration

# Translation
AVAYAR_TRANSLATION_DEFAULT_SOURCE=en

# Optional model cache
# AVAYAR_MODEL_CACHE=/var/cache/avayar/models

# Gemini TTS
# SERVER SIDE ONLY.
# Never embed provider secrets in the extension.
GEMINI_API_KEY=

# Production HTTP runtime
HOST=0.0.0.0
PORT=4173

# Maximum server request duration
AVAYAR_REQUEST_TIMEOUT_MS=120000

# Basic per-instance abuse protection
AVAYAR_RATE_LIMIT_WINDOW_MS=60000
AVAYAR_RATE_LIMIT_MAX=120

# Comma-separated exact allowed Origins.
# Add the published Chrome extension origin once its permanent ID exists.
# Example:
# AVAYAR_CORS_ORIGINS=https://farsio.ir,chrome-extension://EXTENSION_ID
AVAYAR_CORS_ORIGINS=https://farsio.ir

# Production Extension build endpoint.
# Must use HTTPS.
# Example only:
# AVAYAR_PRODUCTION_API_BASE=https://api.example.com

# Production translation provider.
# Production: gemini
# Local/private beta: local-m2m100
AVAYAR_TRANSLATION_PROVIDER=local-m2m100

# Production Gemini text model.
AVAYAR_TRANSLATION_MODEL=gemini-flash-latest
