# AvaYar M3 keyless provider configuration
# No API key, token, account, or cloud credential is required.

# Optional. Default source language used when automatic detection is uncertain.
AVAYAR_TRANSLATION_DEFAULT_SOURCE=en

# Optional. When unset, AvaYar uses a user-home cache.
# Example on Windows:
# AVAYAR_MODEL_CACHE=C:\Users\<you>\AppData\Local\AvaYar\models\transformers
